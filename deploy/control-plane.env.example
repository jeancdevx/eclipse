# Control-plane production profile.
# Copy to deploy/control-plane.env (gitignored) and sync to /opt/eclipse/.env on the CP VM.
# Do not use as the laptop repo-root `.env`.

NODE_ENV=production
AUTH_DEV_BYPASS=false

POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgresql://eclipse:PASSWORD@postgres:5432/eclipse

API_TOKEN=generate-a-long-random-token
BETTER_AUTH_SECRET=generate-a-long-random-secret-32chars-min

BETTER_AUTH_URL=http://20.110.189.87:3000
CORS_ORIGIN=http://20.110.189.87:3000
PUBLIC_API_URL=http://20.110.189.87:4000
API_URL=http://api:4000

GAME_HOST=azure
DOCKER_HOST=ssh://eclipse@13.72.78.201
SSH_PRIVATE_KEY_PATH=/opt/eclipse/eclipse_game
RCON_HOST=13.72.78.201
RCON_PORT=25575
RCON_PASSWORD=generate-a-strong-rcon-password
ECLIPSE_INSTANCES_DIR=/var/lib/eclipse/instances
MC_COMPOSE_FILE=/app/infra/docker/compose.guest.yaml
JOIN_HOST=13.72.78.201
JOIN_PORT=25565
PUBLIC_IP=13.72.78.201
IDLE_MINUTES=30

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=eclipse-rg
AZURE_VM_NAME=eclipse-vm
AZURE_BACKUP_ACCOUNT_URL=https://YOUR_STORAGE.blob.core.windows.net
AZURE_BACKUP_CONTAINER=eclipse-backups

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
AUTH_ALLOWLIST=you@example.com

DISCORD_TOKEN=
