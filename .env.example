# Local development profile
NODE_ENV=development
DATABASE_URL=postgresql://eclipse:eclipse@localhost:5432/eclipse

API_PORT=4000
API_TOKEN=dev-api-token-change-me
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
IDLE_MINUTES=30
GAME_HOST=local
ECLIPSE_INSTANCES_DIR=infra/docker/data/instances
MC_CONTAINER_NAME=eclipse-mc
MC_COMPOSE_FILE=infra/docker/compose.mc.yaml
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=eclipse
BACKUP_DIR=infra/docker/backups
DEFAULT_MC_LOADER=VANILLA
DEFAULT_MC_VERSION=1.21.1
JOIN_PORT=25565

# Auth — Entra for realistic local, or AUTH_DEV_BYPASS=true to skip SSO
BETTER_AUTH_SECRET=dev-secret-change-me-to-32chars-min
BETTER_AUTH_URL=http://localhost:3000
AUTH_DEV_BYPASS=true
AUTH_ALLOWLIST=you@example.com
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# Discord bot (optional locally)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USER_IDS=

# CurseForge (optional)
# CurseForge API key (https://console.curseforge.com/) — required for AUTO_CURSEFORGE.
# Keys look like $2a$10$... Docker Compose treats $ as interpolation: either
# write $$2a$$10$$... in compose-managed .env files, or rely on Eclipse (it escapes
# when writing .eclipse-runtime.env). Plain $2a$10$... is fine for pnpm/dotenv.
# CF_API_KEY=

# Production profile lives in deploy/control-plane.env.example — never overwrite
# this local file with the control-plane env.
GAME_HOST_MEMORY_MB=16384  # Azure D4 ≈ 16 GiB; used to clamp JVM heap
